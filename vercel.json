{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-calendar",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/refresh-tokens",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/retry-webhooks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/pull-calendar",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "0 4 * * *"
    }
  ]
}
